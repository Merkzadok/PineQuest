datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Level {
  id      Int             @id @default(autoincrement())
  title   String
  text    String
  status  String          @default("locked") // or "unlocked"
  readings ReadingSession[]
}

model ReadingSession {
  id       Int     @id @default(autoincrement())
  text     String
  audioUrl String?
  accuracy Float
  stars    Int
  levelId  Int
  level    Level   @relation(fields: [levelId], references: [id])
}
